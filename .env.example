# Environment Variables Example
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# This project is read-only and does not typically require API keys
# for normal operation. The following are optional configurations:

# Custom output path for audit reports
# OUTPUT_PATH=./custom-report.md

# Enable verbose logging
# VERBOSE=true

# Custom CISA KEV URL (for testing or mirror)
# KEV_URL=https://www.cisa.gov/sites/default/files/2024-01-01_cve.json

# Microsoft Security Response Center API key (optional - for higher rate limits)
# MSRC_API_KEY=

# Note: The audit tool uses public APIs that do not require authentication
# API keys are only needed for testing or enterprise environments